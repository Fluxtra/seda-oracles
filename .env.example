# SEDA Oracle Programs - Environment Variables

# Private key for deploying consumer contracts to Mantra Chain
PRIVATE_KEY=

# Mantra Chain EVM RPC (defaults in hardhat.config.ts if not set)
MANTRA_TESTNET_RPC_URL=https://evm.dukong.mantrachain.io
MANTRA_MAINNET_RPC_URL=https://evm.mantrachain.io

# Oracle Program IDs (set after uploading to SEDA network)
HYPE_USD_PROGRAM_ID=
MANTRA_USD_PROGRAM_ID=
HYPE_MANTRA_PROGRAM_ID=
